# Copy this file to .env. Never commit .env.
NODE_ENV=development
PORT=3000

# Local MongoDB (the Recipe database is selected explicitly).
DATABASE=mongodb://127.0.0.1:27017/Recipe
# For Atlas, use your own host and database:
# DATABASE=mongodb+srv://your-user:<password>@your-cluster.mongodb.net/Recipe?retryWrites=true&w=majority
# Supply the raw password below only if DATABASE contains <password>.
# Quote passwords containing #, spaces, or other dotenv-sensitive characters.
DATABASE_PASSWORD=

# Required: generate your own secret (see README). Do not use the example literally.
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Cookie lifetime in days.
JWT_COOKIE_EXPIRES_IN=1

# Optional SMTP settings; required only for password-reset email.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
